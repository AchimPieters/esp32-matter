# Default build configuration. These mirror the settings used by the esp-matter
# examples. If a build fails after an SDK update, diff this file against the
# sdkconfig.defaults of any example under $ESP_MATTER_PATH/examples/.

# --- Partition table (uses the custom table with OTA + factory partition) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Factory data provider: read certs + commissioning data from "fctry" ---
CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER=y
CONFIG_ENABLE_ESP32_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="fctry"

# --- Matter core ---
CONFIG_ESP_MATTER_ENABLE_DATA_MODEL=y

# --- Logging (turn down for production images) ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Recommended security hardening ---------------------------------------
# Leave these OFF while learning (they make re-flashing harder), then turn them
# on for real deployments. See SECURITY.md for the full walkthrough.
# CONFIG_SECURE_BOOT=y
# CONFIG_SECURE_BOOT_V2_ENABLED=y
# CONFIG_SECURE_FLASH_ENC_ENABLED=y
